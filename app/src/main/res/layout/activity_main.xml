<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:id="@+id/main"
    android:background="@drawable/bg_main"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="32dp"
        android:paddingBottom="30dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AirPods."
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"/>

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status"
                android:text="●  Ready"
                android:textColor="#79E8BB"
                android:textSize="12sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wireless, reimagined."
            android:textColor="#8F9DB3"
            android:textSize="14sp"
            android:layout_marginTop="5dp"/>

        <!-- HERO CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_hero"
            android:padding="24dp"
            android:layout_marginTop="28dp"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/imgAirpods"
                android:layout_width="230dp"
                android:layout_height="200dp"
                android:src="@android:drawable/ic_menu_search"
                android:scaleType="fitCenter"
                android:contentDescription="AirPods image"
                android:layout_marginBottom="15dp"/>

            <TextView
                android:id="@+id/txtHeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Discover your AirPods."
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/txtHeroSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open your charging case to begin discovering nearby devices."
                android:textColor="#ACBBD0"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/btnScan"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Start Scanning"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_scan_button"
                android:backgroundTint="@null"
                android:layout_marginTop="28dp"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Stop Scanning"
                android:textAllCaps="false"
                android:textColor="#AFC3E0"
                android:textSize="14sp"
                android:backgroundTint="@android:color/transparent"
                android:enabled="false"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- DEVICES HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="32dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nearby Devices"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtDeviceCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 found"
                android:textColor="#8D9DB8"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- DEVICE CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_glass_card"
            android:padding="20dp"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="◉"
                android:textSize="30sp"
                android:textColor="#86B9FF"
                android:gravity="center"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BLE Discovery"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Apple manufacturer packets"
                    android:textColor="#8D9DB8"
                    android:textSize="12sp"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#A1B9D8"
                android:textSize="28sp"/>

        </LinearLayout>

        <!-- PACKET LOG -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live Packet Monitor"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/txtResults"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_glass_card"
            android:text="Waiting for BLE scan...\n\nOpen your AirPods case nearby."
            android:textColor="#9FB5D2"
            android:textSize="12sp"
            android:typeface="monospace"
            android:gravity="top"
            android:padding="18dp"
            android:scrollbars="vertical"
            android:textIsSelectable="true"
            android:layout_marginTop="14dp"/>

        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bluetooth Low Energy  •  Android 14"
            android:textColor="#63758F"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="28dp"/>

    </LinearLayout>

</ScrollView>
