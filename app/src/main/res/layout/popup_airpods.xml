<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="14dp"
    android:background="@drawable/popup_glass"
    android:elevation="18dp">

    <TextView
        android:id="@+id/closePopup"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="end|center_vertical"
        android:text="✕"
        android:textColor="#BFC7D2"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/deviceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="AirPods Pro"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/caseImage"
            android:layout_width="185dp"
            android:layout_height="135dp"
            android:layout_gravity="bottom|center_horizontal"
            android:src="@drawable/airpods_case"
            android:scaleType="fitCenter"
            android:contentDescription="AirPods case"/>

        <ImageView
            android:id="@+id/leftBud"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/airpods_left"
            android:scaleType="fitCenter"
            android:contentDescription="Left AirPod"/>

        <ImageView
            android:id="@+id/rightBud"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/airpods_right"
            android:scaleType="fitCenter"
            android:contentDescription="Right AirPod"/>

    </FrameLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Connected"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="Ready to listen"
        android:textColor="#AEB8C5"
        android:textSize="11sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/batteryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="Battery"
            android:textColor="#D7DEE8"
            android:textSize="12sp"/>

        <FrameLayout
            android:id="@+id/batteryTrack"
            android:layout_width="55dp"
            android:layout_height="22dp"
            android:background=""
            android:padding="3dp">

            <View
                android:id="@+id/batteryFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:background=""/>

        </FrameLayout>

        <View
            android:layout_width="3dp"
            android:layout_height="9dp"
            android:layout_marginStart="2dp"
            android:background=""/>

        <TextView
            android:id="@+id/batteryPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="--%"
            android:textColor="#30DC70"
            android:textSize="14sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <TextView
        android:id="@+id/donePopup"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/popup_button"
        android:gravity="center"
        android:text="Done"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"/>

</LinearLayout>
