<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/popupRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp"
    android:layout_margin="20dp"
    android:background="@drawable/popup_glass"
    android:elevation="18dp"
    android:layout_gravity="center">
      <TextView
          android:id="@+id/closePopup"
          android:layout_width="match_parent"
          android:layout_height="30dp"
          android:gravity="end|center_vertical"
          android:text="✕"
          android:textColor="#CED5DF"
          android:textSize="21sp"/>
      <TextView
          android:id="@+id/deviceTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:text="AirPods Pro"
          android:textColor="#FFFFFF"
          android:textSize="20sp"
          android:textStyle="bold"
          android:maxLines="2"/>
   <FrameLayout
       android:layout_width="280dp"
       android:layout_height="245dp"
       android:layout_marginTop="8dp">
   <ImageView
       android:id="@+id/caseImage"
       android:layout_width="255dp"
       android:layout_height="190dp"
       android:layout_gravity="bottom|center_horizontal"
       android:src="@drawable/airpods_case"
       android:scaleType="fitCenter"/>
   <ImageView
       android:id="@+id/leftBud"
       android:layout_width="130dp"
       android:layout_height="130dp"
       android:layout_gravity="top|left"
       android:layout_marginStart="30dp"
       android:layout_marginTop="20dp"
       android:src="@drawable/airpods_left"
       android:scaleType="fitCenter"
       tools:ignore="RtlHardcoded" />
   <ImageView
       android:id="@+id/rightBud"
       android:layout_width="130dp"
       android:layout_height="130dp"
       android:layout_gravity="top|right"
       android:layout_marginEnd="30dp"
       android:layout_marginTop="30dp"
       android:src="@drawable/airpods_right"
       android:scaleType="fitCenter"
       tools:ignore="RtlHardcoded" />
   </FrameLayout>
       <TextView
           android:id="@+id/statusText"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:gravity="center"
           android:text="Connected"
           android:textSize="24sp"
           android:textStyle="bold"
           android:textColor="#FFFFFF"/>
       <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:gravity="center"
           android:text="Ready to listen"
           android:textColor="#B9C3D0"
           android:textSize="14sp"
           android:layout_marginTop="6dp"/>
       <TextView
           android:id="@+id/batteryText"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:gravity="center"
           android:text="Battery information unavailable"
           android:textColor="#AAB4C2"
           android:textSize="12sp"
           android:layout_marginTop="8dp"/>
       <TextView
           android:id="@+id/donePopup"
           android:layout_width="match_parent"
           android:layout_height="48dp"
           android:layout_marginTop="20dp"
           android:background="@drawable/popup_button"
           android:gravity="center"
           android:text="Done"
           android:textStyle="bold"
           android:textColor="#FFFFFF"
           android:textSize="16sp"/>
</LinearLayout>